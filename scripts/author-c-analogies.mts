// Drafts one everyday analogy per new C lesson, under the same limits the analogy tests enforce. Writes lib/languages/analogies-extra.ts.
// Usage: npm run author:ca
import { writeFileSync } from "node:fs";
import { z } from "zod";
import { generateStructured } from "@/lib/ai/llm";
import { C_MODULES } from "./authoring/c-modules";

const shortSentences = (s: string) => s.split(/(?<=[.!?])\s+/).every((x) => x.split(/\s+/).length <= 25);
const Item = z.object({
  icon: z.string().min(1).max(8), title: z.string().min(3).max(40),
  text: z.string().min(40).max(220).refine(shortSentences, "every sentence at most 25 words"),
  pairs: z.array(z.tuple([z.string().min(2).max(60), z.string().min(2).max(60)])).min(3).max(4),
  differs: z.string().min(40).max(220).refine(shortSentences, "every sentence at most 25 words"),
});
const Batch = z.object({ analogies: z.array(Item.extend({ key: z.string() })) });

const SYSTEM = `You write one everyday analogy per programming lesson for first-generation college students in India with English as a second language. Use things they know: a railway station, a tiffin box, cricket, a ration shop, buses, a school register, a kirana shop, a bank queue. "icon" is ONE emoji. "text" explains the idea in short sentences. "pairs" are 3 or 4 [everyday thing, code idea] rows. "differs" is honest: where the analogy stops being true. Never claim something false about C. Plain words.`;

async function main() {
  const out: Record<string, unknown> = {};
  for (const m of C_MODULES) {
    for (let attempt = 1; attempt <= 3; attempt++) {
      try {
        const { value } = await generateStructured({ task: "general", promptVersion: "author-ca-1", schema: Batch, temperature: 0.5, maxTokens: 4000, system: SYSTEM,
          user: `Module "${m.title}". Write one analogy for each lesson, using exactly these keys:\n${m.lessons.map((l) => `- ${l.key}: ${l.title} (${l.brief})`).join("\n")}` });
        const keys = new Set(value.analogies.map((a) => a.key));
        const missing = m.lessons.filter((l) => !keys.has(l.key));
        if (missing.length) throw new Error(`missing ${missing.map((l) => l.key).join(", ")}`);
        for (const a of value.analogies) { const { key, ...rest } = a; if (m.lessons.some((l) => l.key === key)) out[`c/${key}`] = rest; }
        console.log(`${m.key}: ${m.lessons.length} analogies`);
        break;
      } catch (e) { console.log(`${m.key} retry ${attempt}: ${(e as Error).message.slice(0, 160)}`); if (attempt === 3) throw e; }
    }
  }
  writeFileSync("lib/languages/analogies-extra.ts", `import type { Analogy } from "./analogies";\n\n// Generated by scripts/author-c-analogies.mts.\nexport const EXTRA_ANALOGIES: Record<string, Analogy> = ${JSON.stringify(out, null, 2)};\n`);
}
main().catch((e) => { console.error(e); process.exit(1); });
