// Collects lib/languages/c/generated/*.json (written by author-c.mts) into the two TypeScript files the track imports:
// challenges-extra.ts (module problems, expected outputs produced by running the Python reference) and native-extra.ts (the C solution CI re-runs).
import { readdirSync, readFileSync, writeFileSync } from "node:fs";

const dir = "lib/languages/c/generated";
const items = readdirSync(dir).filter((f) => f.endsWith(".json")).sort().map((f) => JSON.parse(readFileSync(`${dir}/${f}`, "utf8")) as Record<string, unknown> & { key: string; solutionC: string });
const challenges = Object.fromEntries(items.map(({ key, solutionC: _s, ...c }) => [key, c]));
const natives = Object.fromEntries(items.map((i) => [`c/${i.key}`, i.solutionC]));
writeFileSync("lib/languages/c/challenges-extra.ts", `import type { ModuleChallenge } from "../types";\n\n// Generated by scripts/author-c-index.mts from lib/languages/c/generated. Expected outputs come from running each Python reference.\nexport const extraChallenges: Record<string, ModuleChallenge> = ${JSON.stringify(challenges, null, 2)};\n`);
writeFileSync("lib/languages/c/native-extra.ts", `// Generated by scripts/author-c-index.mts: an independent C solution per module problem, re-run by CI and \`npm run runner:verify\`.\nexport const extraNativeSolutions: Record<string, string> = ${JSON.stringify(natives, null, 2)};\n`);
console.log(`wrote ${items.length} challenges`);
