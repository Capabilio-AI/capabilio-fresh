// Drafts "what does this program print?" snippets for the new C modules and keeps ONLY those the runner proves usable: the program runs, and the mistake edits give at
// least three different wrong outputs. Output: scripts/code-questions/c-extra.mts (read by c.mts). Then run `npm run questions:gen -- c`.
// Usage: npm run author:cq -- <moduleKey|all>
import { writeFileSync, existsSync, readFileSync } from "node:fs";
import { z } from "zod";
import { generateStructured } from "@/lib/ai/llm";
import type { Spec, Language } from "./gen-code-questions.mts";
import { C_MODULES } from "./authoring/c-modules";

const Draft = z.object({ specs: z.array(z.object({
  top: z.string().max(500).optional(), body: z.string().min(10).max(500),
  alt: z.array(z.tuple([z.string().min(1).max(80), z.string().min(1).max(80)])).min(2).max(5),
  wrong: z.array(z.string().min(1).max(80)).min(3).max(4),
  why: z.string().min(20).max(300),
})).min(12).max(14) });

const SYSTEM = `You write "what does this program print?" questions for first-year C students. Each spec has: "body" = the statements inside main (no main, no #include: stdio.h, string.h and stdlib.h are already included, math.h and ctype.h are NOT), optional "top" = declarations before main (functions, structs, macros), "alt" = 3 to 5 ONE-EDIT mistakes, each a [from, to] text replacement where "from" occurs EXACTLY in the body or top as written and the edit gives a program that still compiles but prints DIFFERENT output (the mistakes students really make: off-by-one, = vs ==, / vs %, wrong format, wrong loop bound, forgetting a cast), "wrong" = 3 or 4 DIFFERENT outputs a student might wrongly expect, in exactly the same format as the real output (same number of lines, same style), and "why" = a plain-English reason (short sentences, simple words) for the real output.
Rules: deterministic, no input, no undefined behaviour, no uninitialised variables, prints one to three short lines, output under 100 characters. Different specs must test different ideas from the module.`;

const extraPath = "scripts/code-questions/c-extra.mts";
const header = `// GENERATED by scripts/author-c-questions.mts. Snippets only: the answers are produced by running them (npm run questions:gen -- c).\nimport type { Spec } from "../gen-code-questions.mts";\n\nexport const extra: Spec[] = `;

// loaded by path at run time: TypeScript does not allow a value import that ends in .mts
const GEN = "./gen-code-questions.mts";
const CQ = "./code-questions/c.mts";

async function main() {
  const { build } = (await import(GEN)) as { build: (track: string, lang: Language, specs: readonly Spec[]) => Promise<{ bank: Record<string, unknown[]>; problems: string[] }> };
  const { lang } = (await import(CQ)) as { lang: Language };
  const which = process.argv[2];
  const picked = C_MODULES.filter((m) => which === "all" || m.key === which);
  if (picked.length === 0) throw new Error("usage: author:cq <moduleKey|all>");
  const kept: Spec[] = existsSync(extraPath) ? (JSON.parse(readFileSync(extraPath, "utf8").split("export const extra: Spec[] = ")[1].replace(/;\s*$/, "")) as Spec[]) : [];
  for (const m of picked) {
    const good: Spec[] = [];
    for (let round = 1; round <= 4 && good.length < 10; round++) {
      const { value } = await generateStructured({ task: "general", promptVersion: "author-cq-1", schema: Draft, temperature: 0.5, maxTokens: 6000, system: SYSTEM,
        user: `Module "${m.title}": ${m.summary}\nLessons: ${m.lessons.map((l) => `${l.title} (${l.brief})`).join(" | ")}\nWrite 13 specs spread over all the lessons.` });
      const specs: Spec[] = value.specs.map((s) => ({ m: m.key, ...(s.top ? { top: s.top } : {}), body: s.body, alt: s.alt as [string, string][], wrong: s.wrong, why: s.why }));
      const { bank, problems } = await build("c", lang, specs);
      for (const pr of problems.slice(0, 4)) console.log(`   rejected: ${pr.slice(0, 170)}`);
      const bad = new Set(problems.map((p) => Number(/#(\d+):/.exec(p)?.[1]) - 1));
      specs.forEach((s, i) => { if (!bad.has(i) && good.length < 12) good.push(s); });
      console.log(`${m.key} round ${round}: ${specs.length - bad.size}/${specs.length} usable, ${good.length} kept (${Object.values(bank).flat().length} questions built)`);
    }
    if (good.length < 8) throw new Error(`only ${good.length} usable snippets for ${m.key}`);
    for (let i = kept.length - 1; i >= 0; i--) if (kept[i].m === m.key) kept.splice(i, 1);
    kept.push(...good);
    writeFileSync(extraPath, header + JSON.stringify(kept, null, 2) + ";\n");
  }
}
main().catch((e) => { console.error(e); process.exit(1); });
